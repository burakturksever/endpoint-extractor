DATABASE_URL="file:./prisma/dev.db"
# Optional: SQLite URL params, e.g. file:./prisma/dev.db?busy_timeout=10000 (helps under heavy writes).
# Limit which browser requests create Endpoint rows (comma-separated Playwright resource types, or * for all).
ENDPOINT_CAPTURE_RESOURCE_TYPES=xhr,fetch
# Optional: when set, server-side LLM calls use this OpenAI-compatible base URL instead of the value stored in App Settings (useful in Docker to reach the host: http://host.docker.internal:1234/v1).
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Optional Postgres mode (app still runs natively on host, DB in Docker).
# Start DB: docker compose up -d postgres
# Then switch DATABASE_URL and run:
# npm run prisma:generate:postgres
# npm run prisma:dbpush:postgres
# DATABASE_URL="postgresql://endpoint_extractor:endpoint_extractor@127.0.0.1:5432/endpoint_extractor?schema=public"
